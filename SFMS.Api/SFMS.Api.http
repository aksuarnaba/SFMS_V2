@SFMS_Api_HostAddress = https://localhost:7280

###
# LOGIN
# @name login

POST {{SFMS_Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "site": 1,
  "employeeNumber": "SA",
  "password": "Password123"
}

###
# GET USERS
# Uses the JWT returned from login above

GET {{SFMS_Api_HostAddress}}/api/users?pageNumber=1&pageSize=20
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json