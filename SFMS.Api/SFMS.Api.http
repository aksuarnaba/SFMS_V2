@SFMS.Api_HostAddress = http://localhost:5062

### 1. Login Request
# @name loginRequest
POST {{SFMS.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "site": 1,
  "employeeNumber": "SA",
  "password": "SA"
}

###

@response_handler = {%
    client.global.set("auth_token", response.body.accessToken);
    console.log("Token captured: " + response.body.accessToken);
%}

###

