<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================================== -->
    <!-- SFMS BRAND                            -->
    <!-- ===================================== -->

    <Color x:Key="Primary">
        #4169E1
    </Color>

    <Color x:Key="PrimaryHover">
        #5278E6
    </Color>

    <Color x:Key="PrimaryPressed">
        #3157C8
    </Color>

    <Color x:Key="PrimaryDisabled">
        #A8B8EC
    </Color>

    <Color x:Key="PrimaryLight">
        #EEF2FF
    </Color>

    <Color x:Key="Secondary">
        #1E90FF
    </Color>

    <Color x:Key="BrandNavy">
        #14243D
    </Color>


    <!-- ===================================== -->
    <!-- SIDEBAR                               -->
    <!-- ===================================== -->

    <!--
        Slightly darker Royal Blue than Primary.
        Creates contrast between navigation and
        application actions.
    -->

    <Color x:Key="SidebarBackground">
        #3157C8
    </Color>

    <Color x:Key="SidebarSurface">
        #4169E1
    </Color>

    <!-- Normal navigation text -->

    <Color x:Key="SidebarText">
        #DFE7FF
    </Color>

    <!-- Section labels: OPERATIONS / SYSTEM -->

    <Color x:Key="SidebarMuted">
        #B9C8F5
    </Color>

    <Color x:Key="SidebarDivider">
        #5575CC
    </Color>

    <!-- Selected navigation item -->

    <Color x:Key="SidebarSelected">
        #5278E6
    </Color>

    <Color x:Key="SidebarSelectedText">
        #FFFFFF
    </Color>


    <!-- ===================================== -->
    <!-- APPLICATION SURFACES                  -->
    <!-- ===================================== -->

    <Color x:Key="AppBackground">
        #F4F7FB
    </Color>

    <Color x:Key="Background">
        #F4F7FB
    </Color>

    <Color x:Key="Surface">
        #FFFFFF
    </Color>

    <Color x:Key="SurfaceMuted">
        #F8FAFD
    </Color>

    <Color x:Key="LoginBackground">
        #F2F6FC
    </Color>


    <!-- ===================================== -->
    <!-- TEXT                                  -->
    <!-- ===================================== -->

    <Color x:Key="TextPrimary">
        #172033
    </Color>

    <Color x:Key="TextSecondary">
        #5E6D82
    </Color>

    <Color x:Key="TextMuted">
        #8B99AD
    </Color>


    <!-- ===================================== -->
    <!-- FORMS / BORDERS                       -->
    <!-- ===================================== -->

    <Color x:Key="Border">
        #DDE5EE
    </Color>

    <Color x:Key="BorderLight">
        #EBF0F5
    </Color>

    <Color x:Key="FieldBorder">
        #CED8E5
    </Color>

    <Color x:Key="FieldBackground">
        #FFFFFF
    </Color>


    <!-- ===================================== -->
    <!-- SEMANTIC COLORS                       -->
    <!-- ===================================== -->

    <Color x:Key="Success">
        #15803D
    </Color>

    <Color x:Key="SuccessLight">
        #ECFDF3
    </Color>

    <Color x:Key="Warning">
        #C66A08
    </Color>

    <Color x:Key="WarningLight">
        #FFF7E8
    </Color>

    <Color x:Key="Danger">
        #C62F2F
    </Color>

    <Color x:Key="DangerLight">
        #FEF2F2
    </Color>

    <Color x:Key="Info">
        #0284C7
    </Color>

</ResourceDictionary>