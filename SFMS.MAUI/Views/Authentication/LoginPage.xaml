<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:models="clr-namespace:SFMS.MAUI.Models.Authentication"
    x:Class="SFMS.MAUI.Views.Authentication.LoginPage"
    Title="SFMS Sign In"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <Grid
        ColumnDefinitions="1.05*,0.95*"
        RowDefinitions="*">

        <!-- Enterprise branding panel -->
        <Border
            Grid.Column="0"
            StrokeThickness="0"
            Padding="56">

            <Border.Background>
                <LinearGradientBrush
                    StartPoint="0,0"
                    EndPoint="1,1">

                    <GradientStop
                        Color="{StaticResource BrandNavy}"
                        Offset="0" />

                    <GradientStop
                        Color="{StaticResource PrimaryDark}"
                        Offset="0.55" />

                    <GradientStop
                        Color="{StaticResource Primary}"
                        Offset="1" />

                </LinearGradientBrush>
            </Border.Background>

            <Grid
                RowDefinitions="Auto,*,Auto">

                <VerticalStackLayout
                    Grid.Row="0"
                    Spacing="6">

                    <Label
                        Text="SFMS"
                        FontFamily="MontserratExtraBold"
                        FontSize="56"
                        CharacterSpacing="2"
                        TextColor="White" />

                    <Label
                        Text="SHOPFLOOR MANAGEMENT SYSTEM"
                        FontFamily="OpenSansSemibold"
                        FontSize="13"
                        CharacterSpacing="1.4"
                        TextColor="#DCEBFF" />

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Row="1"
                    VerticalOptions="Center"
                    Spacing="20"
                    MaximumWidthRequest="520"
                    HorizontalOptions="Start">

                    <Label
                        Text="Production visibility where the work happens."
                        FontFamily="MontserratExtraBold"
                        FontSize="34"
                        LineHeight="1.1"
                        TextColor="White" />

                    <Label
                        Text="Manage pallet tagging, production monitoring, and shopfloor checklists through one secure internal system."
                        FontSize="16"
                        LineHeight="1.45"
                        TextColor="#E5EFFF" />

                    <VerticalStackLayout
                        Margin="0,16,0,0"
                        Spacing="12">

                        <Label
                            Text="✓  On-premises production network"
                            TextColor="White"
                            FontSize="14" />

                        <Label
                            Text="✓  Pallet tracking and tag generation"
                            TextColor="White"
                            FontSize="14" />

                        <Label
                            Text="✓  Monitoring checklist workflow"
                            TextColor="White"
                            FontSize="14" />

                        <Label
                            Text="✓  Windows and Android access"
                            TextColor="White"
                            FontSize="14" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout
                    Grid.Row="2"
                    Spacing="4">

                    <Label
                        Text="INTERNAL PRODUCTION SYSTEM"
                        FontFamily="OpenSansSemibold"
                        FontSize="11"
                        CharacterSpacing="1"
                        TextColor="#DCEBFF" />

                    <Label
                        Text="Authorized personnel only"
                        FontSize="11"
                        TextColor="#B9D3F7" />

                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- Login area -->
        <ScrollView
            Grid.Column="1"
            VerticalScrollBarVisibility="Never">

            <Grid
                Padding="48,36"
                MinimumHeightRequest="680">

                <Border
                    Padding="38"
                    MaximumWidthRequest="470"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                    <Border.Shadow>
                        <Shadow
                            Brush="#172033"
                            Opacity="0.12"
                            Radius="24"
                            Offset="0,8" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="Sign in to SFMS"
                                FontFamily="MontserratExtraBold"
                                FontSize="28"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Use your assigned SFMS production account."
                                FontSize="14"
                                TextColor="{StaticResource TextSecondary}" />

                        </VerticalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{StaticResource BorderLight}" />

                        <material:PickerField
                            Title="Site"
                            ItemsSource="{Binding Sites}"
                            SelectedItem="{Binding SelectedSite}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            AllowClear="False"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Border}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource Surface}"
                            CornerRadius="10"
                            HeightRequest="60" />

                        <material:TextField
                            Title="Employee number"
                            Text="{Binding EmployeeNumber}"
                            Keyboard="Text"
                            ReturnType="Next"
                            AllowClear="True"
                            SelectAllTextOnFocus="True"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Border}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource Surface}"
                            CornerRadius="10"
                            HeightRequest="60" />

                        <material:TextField
                            Title="Password"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding LoginCommand}"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Border}"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource Surface}"
                            CornerRadius="10"
                            HeightRequest="60" />

                        <Border
                            IsVisible="{Binding HasError}"
                            Padding="12,10"
                            Stroke="#FECACA"
                            BackgroundColor="#FEF2F2"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding Message}"
                                FontSize="13"
                                TextColor="{StaticResource Danger}"
                                LineBreakMode="WordWrap" />

                        </Border>

                        <Button
                            Text="Sign in"
                            Command="{Binding LoginCommand}"
                            
                            HeightRequest="52"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="10" />

                        <HorizontalStackLayout
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            Spacing="10">

                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource Primary}"
                                WidthRequest="20"
                                HeightRequest="20" />

                            <Label
                                Text="Connecting to SFMS..."
                                VerticalTextAlignment="Center"
                                FontSize="13"
                                TextColor="{StaticResource TextSecondary}" />

                        </HorizontalStackLayout>

                        <BoxView
                            Margin="0,4,0,0"
                            HeightRequest="1"
                            BackgroundColor="{StaticResource BorderLight}" />

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="2">

                                <Label
                                    Text="Need access?"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Text="Contact the local SFMS administrator."
                                    FontSize="11"
                                    TextColor="{StaticResource TextSecondary}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="v1.0.0"
                                VerticalOptions="Center"
                                FontSize="11"
                                TextColor="{StaticResource TextMuted}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </ScrollView>

    </Grid>
</ContentPage>