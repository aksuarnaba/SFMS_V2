<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:branding="clr-namespace:SFMS.MAUI.Components.Branding"
    x:Class="SFMS.MAUI.Views.Authentication.LoginPage"
    Title="SFMS Sign In"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource Background}">

    <Grid
        ColumnDefinitions="1.05*,0.95*"
        RowDefinitions="*">

        <!-- ========================================= -->
        <!-- BRAND / MACHINE PANEL                     -->
        <!-- ========================================= -->

        <Border
            Grid.Column="0"
            BackgroundColor="{StaticResource BrandNavy}"
            StrokeThickness="0">

            <Grid>

                <Image
                    Source="offset_machine.jpg"
                    Aspect="AspectFill"
                    Opacity="0.78" />

                <BoxView InputTransparent="True">

                    <BoxView.Background>

                        <LinearGradientBrush
                            StartPoint="0,0"
                            EndPoint="1,1">

                            <GradientStop
                                Color="#E014243D"
                                Offset="0" />

                            <GradientStop
                                Color="#B8385DCC"
                                Offset="0.58" />

                            <GradientStop
                                Color="#954169E1"
                                Offset="1" />

                        </LinearGradientBrush>

                    </BoxView.Background>

                </BoxView>

                <Grid
                    x:Name="BrandContent"
                    Padding="58,48"
                    Opacity="0"
                    TranslationX="-20"
                    RowDefinitions="Auto,*,Auto">

                    <!-- Larger SFMS logo -->

                    <branding:BrandLogo
                        Grid.Row="0"
                        Variant="Full"
                        Theme="Dark"
                        HorizontalOptions="Start" />

                    <!--
                        Intentionally empty center.

                        The offset press image is now the
                        visual focus instead of marketing copy.
                    -->

                    <Grid Grid.Row="1" />

                    <!-- Internal system footer -->

                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="4">

                        <Label
                            Text="PRINTWELL INTERNAL PRODUCTION SYSTEM"
                            FontFamily="InterSemiBold"
                            FontSize="10"
                            CharacterSpacing="1.05"
                            TextColor="White" />

                        <Label
                            Text="Authorized personnel only"
                            FontFamily="InterRegular"
                            FontSize="11"
                            TextColor="#DDE8FA" />

                        <Label
                            Text="Aron Kyle Suarnaba"
                            FontFamily="LatoRegular"
                            FontSize="9"
                            TextColor="#DDE8FA" />

                    </VerticalStackLayout>

                </Grid>

            </Grid>

        </Border>


        <!-- ========================================= -->
        <!-- LOGIN AREA                                -->
        <!-- ========================================= -->

        <ScrollView
            Grid.Column="1"
            VerticalScrollBarVisibility="Never"
            BackgroundColor="{StaticResource LoginBackground}">

            <Grid
                Padding="48,38"
                MinimumHeightRequest="680">

                <!-- Floating sign-in card -->

                <Border
                    x:Name="LoginCard"
                    Opacity="0"
                    TranslationY="20"
                    Padding="38,36"
                    WidthRequest="420"
                    MaximumWidthRequest="420"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="#EEF2F7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26">

                    <Border.Shadow>

                        <Shadow
                            Brush="#10213B"
                            Opacity="0.16"
                            Radius="32"
                            Offset="0,12" />

                    </Border.Shadow>

                    <VerticalStackLayout Spacing="22">

                        <!-- Header -->

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="Sign in to SFMS"
                                FontFamily="InterBold"
                                FontSize="28"
                                CharacterSpacing="-0.25"
                                TextColor="{StaticResource TextPrimary}" />

                            <Label
                                Text="Use your assigned production account."
                                FontFamily="InterRegular"
                                FontSize="13"
                                TextColor="{StaticResource TextSecondary}" />

                        </VerticalStackLayout>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="{StaticResource BorderLight}" />


                        <!-- Site -->

                        <material:PickerField
                            Title="Site"
                            ItemsSource="{Binding Sites}"
                            SelectedItem="{Binding SelectedSite}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            AllowClear="False"
                            FontFamily="InterMedium"
                            FontSize="14"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource FieldBorder}"
                            BorderThickness="1"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource FieldBackground}"
                            CornerRadius="11"
                            HeightRequest="58" />


                        <!-- Employee number -->

                        <material:TextField
                            Title="Employee Number"
                            Text="{Binding EmployeeNumber}"
                            Keyboard="Text"
                            ReturnType="Next"
                            AllowClear="True"
                            SelectAllTextOnFocus="True"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            CharacterSpacing="0.35"
                            FontFamily="InterMedium"
                            FontSize="14"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource FieldBorder}"
                            BorderThickness="1"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource FieldBackground}"
                            CornerRadius="11"
                            HeightRequest="58" />


                        <!-- Password -->

                        <material:TextField
                            Title="Password"
                            Text="{Binding Password}"
                            IsPassword="True"
                            ReturnType="Go"
                            ReturnCommand="{Binding LoginCommand}"
                            FontFamily="InterMedium"
                            FontSize="14"
                            AccentColor="{StaticResource Primary}"
                            BorderColor="{StaticResource FieldBorder}"
                            BorderThickness="1"
                            TextColor="{StaticResource TextPrimary}"
                            TitleColor="{StaticResource TextSecondary}"
                            InputBackgroundColor="{StaticResource FieldBackground}"
                            CornerRadius="11"
                            HeightRequest="58" />


                        <!-- Error message -->

                        <Border
                            IsVisible="{Binding HasError}"
                            Padding="12,10"
                            BackgroundColor="#FEF2F2"
                            Stroke="#FECACA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9">

                            <Label
                                Text="{Binding Message}"
                                FontFamily="InterRegular"
                                FontSize="12"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Danger}" />

                        </Border>


                        <!-- Sign in -->

                        <Button
                            Text="Sign in"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource LoginPrimaryButton}" />


                        <!-- Working state -->

                        <HorizontalStackLayout
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            Spacing="10">

                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                Color="{StaticResource Primary}"
                                WidthRequest="18"
                                HeightRequest="18" />

                            <Label
                                Text="Connecting to SFMS..."
                                VerticalTextAlignment="Center"
                                FontFamily="InterRegular"
                                FontSize="12"
                                TextColor="{StaticResource TextSecondary}" />

                        </HorizontalStackLayout>


                        <BoxView
                            Margin="0,2,0,0"
                            HeightRequest="1"
                            BackgroundColor="{StaticResource BorderLight}" />


                        <!-- Footer -->

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Need access?"
                                    FontFamily="InterSemiBold"
                                    FontSize="11"
                                    TextColor="{StaticResource TextPrimary}" />

                                <Label
                                    Text="Contact the IT Administrator."
                                    FontFamily="InterRegular"
                                    FontSize="10"
                                    TextColor="{StaticResource TextSecondary}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="v1.0.0"
                                VerticalOptions="Center"
                                FontFamily="InterRegular"
                                FontSize="10"
                                TextColor="{StaticResource TextMuted}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </ScrollView>

    </Grid>

</ContentPage>