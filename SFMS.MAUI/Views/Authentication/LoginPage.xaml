<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="SFMS.MAUI.Views.Authentication.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1E90FF">

    <Grid>

        <!-- ===================================== -->
        <!-- BACKGROUND IMAGE                      -->
        <!-- ===================================== -->

        <Image Source="offset_machine.jpg"
               Aspect="AspectFill"
               Opacity="0.65" />

        <!-- ===================================== -->
        <!-- DODGER BLUE GRADIENT OVERLAY           -->
        <!-- ===================================== -->

        <BoxView InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">

                    <GradientStop Color="#CC1E90FF"
                                  Offset="0.0" />

                    <GradientStop Color="#991E90FF"
                                  Offset="0.50" />

                    <GradientStop Color="#CCFFFFFF"
                                  Offset="1.0" />

                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- ===================================== -->
        <!-- MAIN CONTENT                          -->
        <!-- ===================================== -->

        <ScrollView VerticalOptions="Fill"
                    HorizontalOptions="Fill"
                    VerticalScrollBarVisibility="Never"
                    HorizontalScrollBarVisibility="Never">

            <Grid Padding="20,30">

                <VerticalStackLayout Spacing="20"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <!-- ===================================== -->
                    <!-- BRANDING                              -->
                    <!-- ===================================== -->

                    <VerticalStackLayout Spacing="2"
                                         HorizontalOptions="Center">

                        <Label Text="SFMS"
                               FontFamily="MontserratExtraBold"
                               FontSize="58"
                               CharacterSpacing="2"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Label Text="SHOPFLOOR MANAGEMENT SYSTEM"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               TextColor="White"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <!-- ===================================== -->
                    <!-- GLASS LOGIN CARD                     -->
                    <!-- ===================================== -->

                    <Border WidthRequest="380"
                            HeightRequest="600"
                            MaximumWidthRequest="440"
                            Padding="25"
                            Stroke="#80FFFFFF"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            HorizontalOptions="Center">

                        <!-- GLASS GRADIENT -->
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#F5FBFF"
                                              Offset="0.0" />

                                <GradientStop Color="#E4F2FF"
                                              Offset="0.55" />

                                <GradientStop Color="#C8E4FF"
                                              Offset="1.0" />

                            </LinearGradientBrush>
                        </Border.Background>

                        <!-- CARD SHADOW -->
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.20"
                                    Radius="22"
                                    Offset="0,10" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="17">

                            <!-- ===================================== -->
                            <!-- FORM HEADER                           -->
                            <!-- ===================================== -->

                            <VerticalStackLayout Spacing="5"
                                                 Margin="0,0,0,8">

                                <Label Text="Welcome Back!"
                                       FontSize="24"
                                       
                                       FontAttributes="Bold"
                                       TextColor="#173B5E"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="Sign in to your account"
                                       FontSize="13"
                                       TextColor="#526B82"
                                       HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                            <!-- ===================================== -->
                            <!-- COMPANY                               -->
                            <!-- ===================================== -->

                            <material:PickerField
                                Title="Company"
                                TitleColor="#526B82"
                                TextColor="#173B5E"
                                AccentColor="#1E90FF"
                                BorderColor="#7AB8F5"
                                BorderThickness="1.5"
                                InputBackgroundColor="#F8FCFF"
                                CornerRadius="10"
                                SelectedItem="{Binding SelectedCompany}"
                                ItemsSource="{Binding Companies}"
                                HeightRequest="58"
                                HorizontalOptions="Fill"
                                AllowClear="False" />

                            <!-- ===================================== -->
                            <!-- EMPLOYEE NUMBER                       -->
                            <!-- ===================================== -->

                            <material:TextField
                                Title="Employee Number"
                                Text="{Binding EmployeeNumber}"
                                TitleColor="#526B82"
                                TextColor="#173B5E"
                                AccentColor="#1E90FF"
                                BorderColor="#7AB8F5"
                                BorderThickness="1.5"
                                InputBackgroundColor="#F8FCFF"
                                CornerRadius="10"
                                Keyboard="Text"
                                AllowClear="True"
                                HeightRequest="58"
                                HorizontalOptions="Fill" />

                            <!-- ===================================== -->
                            <!-- PASSWORD                              -->
                            <!-- ===================================== -->

                            <material:TextField
                                Title="Password"
                                Text="{Binding Password}"
                                IsPassword="True"
                                TitleColor="#526B82"
                                TextColor="#173B5E"
                                AccentColor="#1E90FF"
                                BorderColor="#7AB8F5"
                                BorderThickness="1.5"
                                InputBackgroundColor="#F8FCFF"
                                CornerRadius="10"
                                HeightRequest="58"
                                HorizontalOptions="Fill" />

                            <!-- ===================================== -->
                            <!-- WORK SHIFT                            -->
                            <!-- ===================================== -->

                            <material:PickerField
                                Title="Work Shift"
                                TitleColor="#526B82"
                                TextColor="#173B5E"
                                AccentColor="#1E90FF"
                                BorderColor="#7AB8F5"
                                BorderThickness="1.5"
                                InputBackgroundColor="#F8FCFF"
                                CornerRadius="10"
                                SelectedItem="{Binding SelectedShift}"
                                ItemsSource="{Binding Shifts}"
                                HeightRequest="58"
                                HorizontalOptions="Fill"
                                AllowClear="False" />

                            <!-- ===================================== -->
                            <!-- FEEDBACK MESSAGE                      -->
                            <!-- ===================================== -->

                            <Label Text="{Binding Message}"
                                   TextColor="#B42318"
                                   FontSize="13"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <!-- ===================================== -->
                            <!-- LOGIN BUTTON                          -->
                            <!-- ===================================== -->

                            <Button Text="SIGN IN"
                                    Command="{Binding LoginCommand}"
                                    BackgroundColor="#1E90FF"
                                    TextColor="White"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HeightRequest="52"
                                    CornerRadius="10"
                                    Margin="0,5,0,0" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- ===================================== -->
                    <!-- FOOTER                                -->
                    <!-- ===================================== -->

                    <VerticalStackLayout Spacing="4"
                                         HorizontalOptions="Center">

                        <Label Text="SFMS  •  Version 1.0.0"
                               FontSize="11"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Powered by Printwell, Inc."
                               FontSize="10"
                               TextColor="#EAF3FF"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Grid>

        </ScrollView>

    </Grid>

</ContentPage>
