<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:navigation="clr-namespace:SFMS.MAUI.Components.Navigation"
    xmlns:branding="clr-namespace:SFMS.MAUI.Components.Branding"
    x:Class="SFMS.MAUI.Components.Layout.AppSidebar"
    x:Name="Root">

    <Border
        BackgroundColor="{StaticResource SidebarBackground}"
        StrokeThickness="0">

        <Grid
            Padding="16,22"
            RowDefinitions="Auto,*,Auto">

            <!-- =========================== -->
            <!-- BRAND                       -->
            <!-- =========================== -->

            <branding:BrandLogo
                Grid.Row="0"
                Margin="5,6,5,34"
                Variant="Full"
                Theme="Dark"
                HorizontalOptions="Start" />



            <!-- =========================== -->
            <!-- NAVIGATION                  -->
            <!-- =========================== -->

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="6">

                <Label
                    Text="OPERATIONS"
                    Margin="14,0,0,8"
                    FontFamily="LatoBold"
                    FontSize="9"
                    CharacterSpacing="1.4"
                    TextColor="{StaticResource SidebarMuted}" />


                <navigation:NavigationItem
                    x:Name="DashboardItem"
                    Title="Dashboard"
                    
                    Icon="D"
                    Route="Dashboard"
                    IsSelected="True"
                    NavigationRequested="OnNavigationRequested" />


                <navigation:NavigationItem
                    x:Name="PalletTaggingItem"
                    Title="Pallet Tagging"
                    Icon="P"
                    Route="PalletTagging"
                    NavigationRequested="OnNavigationRequested" />


                <navigation:NavigationItem
                    x:Name="ProductionItem"
                    Title="Production"
                    Icon="J"
                    Route="Production"
                    NavigationRequested="OnNavigationRequested" />


                <navigation:NavigationItem
                    x:Name="MonitoringItem"
                    Title="Monitoring"
                    Icon="M"
                    Route="Monitoring"
                    NavigationRequested="OnNavigationRequested" />


                <navigation:NavigationItem
                    x:Name="ReportsItem"
                    Title="Reports"
                    Icon="R"
                    Route="Reports"
                    NavigationRequested="OnNavigationRequested" />


                <!-- System section -->

                <Label
                    Text="SYSTEM"
                    Margin="14,24,0,8"
                    FontFamily="LatoBold"
                    FontSize="9"
                    CharacterSpacing="1.4"
                    TextColor="{StaticResource SidebarMuted}" />


                <navigation:NavigationItem
                    x:Name="AdministrationItem"
                    Title="Administration"
                    Icon="A"
                    Route="Administration"
                    NavigationRequested="OnNavigationRequested" />

            </VerticalStackLayout>


            <!-- =========================== -->
            <!-- BOTTOM                      -->
            <!-- =========================== -->

            <VerticalStackLayout
                Grid.Row="2"
                Spacing="6">

                <BoxView
                    HeightRequest="1"
                    Margin="6,0,6,10"
                    BackgroundColor="{StaticResource SidebarDivider}" />


                <navigation:NavigationItem
                    x:Name="SettingsItem"
                    Title="Settings"
                    Icon="S"
                    Route="Settings"
                    NavigationRequested="OnNavigationRequested" />


                <navigation:NavigationItem
                    Title="Sign out"
                    Icon="X"
                    Route="Logout"
                    NavigationRequested="OnNavigationRequested" />

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>